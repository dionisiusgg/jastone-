# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Nomor WhatsApp format internasional tanpa + atau spasi
NEXT_PUBLIC_WHATSAPP_NUMBER=6285176727488

# URL situs (untuk SEO / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CATATAN: service role key TIDAK dipakai di aplikasi ini dan tidak boleh
# pernah dimasukkan ke variabel NEXT_PUBLIC_*.
